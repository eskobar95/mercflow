# Copy to infra/db/.env on the DB VPS. Never commit real values.
# See infra/db/README.md

# Primary superuser — created by Postgres image on first boot
POSTGRES_USER=mercflow_migration
POSTGRES_MIGRATION_PASSWORD=
POSTGRES_DB=mercflow

# Application roles (created by setup-roles.sh)
MERCFLOW_APP_PASSWORD=
MERCFLOW_OWNER_PASSWORD=

# --- Backup (Hetzner Object Storage) ---
HETZNER_S3_ACCESS_KEY=
HETZNER_S3_SECRET_KEY=
HETZNER_S3_BUCKET=mercflow-backups
HETZNER_S3_ENDPOINT=https://nbg1.your-objectstorage.com
HETZNER_S3_REGION=nbg1
BACKUP_RETENTION_DAYS=30

# pg_dump source — migration superuser on local postgres service
DATABASE_URL=postgresql://mercflow_migration:CHANGE_ME@postgres:5432/mercflow
