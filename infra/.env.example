# Copy to infra/.env on the Hetzner app VPS. Never commit real values.
# See infra/RUNBOOK.md
# Database: self-hosted PostgreSQL on dedicated DB VPS (ADR-018)

# --- Core ---
DOMAIN=api.mercflow.shop
ACME_EMAIL=ops@mercflow.shop

# Self-hosted Postgres (private IP of DB VPS — mercflow_app role, NOBYPASSRLS)
DATABASE_URL=postgresql://mercflow_app:CHANGE_ME@10.0.0.2:5432/mercflow?sslmode=disable

# Medusa secrets (generate: openssl rand -hex 32)
JWT_SECRET=
COOKIE_SECRET=
MERCFLOW_CONNECTOR_ENCRYPTION_KEY=

# Redis is internal to compose; REDIS_URL is set in docker-compose.yml
# REDIS_URL=redis://redis:6379

# Amazon SES (notification-module T057/T058) — IAM user mercflow
# Region must match SES identity region (eu-north-1 for mail.mercflow.shop)
# AWS_REGION=eu-north-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# Optional — omit to resolve via STS GetCallerIdentity at runtime
# AWS_ACCOUNT_ID=

# --- Observability ---
SENTRY_DSN=
# Better Stack Logs — source token from Logs → Sources
BETTERSTACK_SOURCE_TOKEN=
# Better Stack Uptime API — optional; create monitor via API (Uptime → API tokens)
BETTERSTACK_UPTIME_API_TOKEN=
# Legacy / unused if using syslog driver or Vector; keep empty unless docs specify
BETTERSTACK_COLLECTOR_SECRET=

# --- Grafana ---
GRAFANA_ADMIN_PASSWORD=

# --- Platform Console (T067) — Clerk mercflow-platform + IP allowlist ---
# PLATFORM_CLERK_SECRET_KEY=
# PLATFORM_DATABASE_URL=postgresql://mercflow_owner:CHANGE_ME@10.0.0.2:5432/mercflow?sslmode=disable
# PLATFORM_CORS=https://console.mercflow.shop
# Update operator IPs in infra/traefik/dynamic/platform-console.yml before deploy.

# --- Optional CORS overrides (comma-separated origins) ---
# STORE_CORS=https://shop.example.com

# --- Tenant provisioning (T030 — operator workstation, not required on app VPS) ---
# MEDUSA_BACKEND_URL=https://api.mercflow.shop
# MEDUSA_ADMIN_API_TOKEN=
# DATABASE_URL=postgresql://mercflow_migration:...@db-private-ip:5432/mercflow  # migrations + medusa exec store creation
# TRAEFIK_DYNAMIC_DIR=infra/traefik/dynamic/tenants

# --- Deprecated (Neon migration — remove after cutover) ---
# NEON_DATABASE_URL=
