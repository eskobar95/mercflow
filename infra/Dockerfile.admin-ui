# MercFlow admin UI — static Vite build served by nginx (T027)
# Build context: repository root

FROM node:22-alpine AS base
RUN apk add --no-cache libc6-compat
RUN corepack enable && corepack prepare pnpm@9.15.0 --activate
WORKDIR /app

FROM base AS deps
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY packages/design-tokens/package.json packages/design-tokens/
COPY packages/shared/package.json packages/shared/
COPY packages/admin-ui/package.json packages/admin-ui/
RUN pnpm install --frozen-lockfile

FROM deps AS build
ARG VITE_MEDUSA_ADMIN_BACKEND_URL=https://api.mercflow.shop
ARG VITE_ADMIN_BASE_PATH=/app/
ARG VITE_CLERK_PUBLISHABLE_KEY=
ARG VITE_MERCFLOW_DEFAULT_STORE_ID=
ENV VITE_MEDUSA_ADMIN_BACKEND_URL=$VITE_MEDUSA_ADMIN_BACKEND_URL
ENV VITE_ADMIN_BASE_PATH=$VITE_ADMIN_BASE_PATH
ENV VITE_CLERK_PUBLISHABLE_KEY=$VITE_CLERK_PUBLISHABLE_KEY
ENV VITE_MERCFLOW_DEFAULT_STORE_ID=$VITE_MERCFLOW_DEFAULT_STORE_ID
COPY packages/design-tokens packages/design-tokens
COPY packages/shared packages/shared
COPY packages/admin-ui packages/admin-ui
RUN pnpm --filter @mercflow/design-tokens build && \
    pnpm --filter @mercflow/shared build && \
    pnpm --filter @mercflow/admin-ui build

FROM nginx:1.27-alpine AS runner
COPY infra/nginx/admin-ui.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/packages/admin-ui/dist /usr/share/nginx/html
EXPOSE 8080
