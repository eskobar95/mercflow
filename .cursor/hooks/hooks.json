{
  "version": 1,
  "hooks": {
    "afterFileEdit": [
      {
        "command": ".cursor/hooks/run-typecheck.sh",
        "failClosed": true,
        "timeout": 120
      },
      {
        "command": ".cursor/hooks/run-security-audit.sh",
        "failClosed": false,
        "timeout": 180
      }
    ],
    "stop": [
      {
        "command": ".cursor/hooks/run-stop-checks.sh",
        "failClosed": false,
        "loop_limit": 3,
        "timeout": 60
      }
    ],
    "beforeShellExecution": [
      {
        "command": ".cursor/hooks/guard-branches.sh",
        "failClosed": true,
        "timeout": 10
      },
      {
        "command": ".cursor/hooks/guard-secrets.sh",
        "failClosed": true,
        "timeout": 10
      }
    ]
  }
}
