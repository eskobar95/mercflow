{
  "name": "@mercflow/design-tokens",
  "version": "0.1.0",
  "private": true,
  "description": "Shared design tokens (CSS custom properties and typed maps) for MercFlow admin UI",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./mercflow-tokens.css": "./dist/mercflow-tokens.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc && node dist/build/writeCssFile.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "typescript": "^5.6.3",
    "vitest": "^3.2.0"
  },
  "engines": {
    "node": ">=20"
  }
}
