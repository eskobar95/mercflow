{
  "name": "@mercflow/content-module",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "description": "MercFlow Medusa v2 custom module: native product and category content fields (DML, migrations, service).",
  "main": "src/modules/content/index.ts",
  "exports": {
    ".": "./src/modules/content/index.ts",
    "./models": "./src/models/index.ts",
    "./mercflow-product-content-api": "./src/integrations/mercflow-product-content-api.ts",
    "./mercflow-admin-product-content-post-route": "./src/integrations/mercflow-admin-product-content-post-route.ts",
    "./mercflow-admin-product-content-read-route": "./src/integrations/mercflow-admin-product-content-read-route.ts",
    "./mercflow-store-product-content-read-route": "./src/integrations/mercflow-store-product-content-read-route.ts",
    "./mercflow-admin-category-content-read-route": "./src/integrations/mercflow-admin-category-content-read-route.ts",
    "./mercflow-admin-category-content-post-route": "./src/integrations/mercflow-admin-category-content-post-route.ts",
    "./mercflow-store-category-content-read-route": "./src/integrations/mercflow-store-category-content-read-route.ts",
    "./mercflow-category-content-api": "./src/integrations/mercflow-category-content-api.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "medusa db:generate content",
    "db:migrate": "medusa db:migrate",
    "db:rollback": "medusa db:rollback --modules content"
  },
  "dependencies": {
    "@medusajs/framework": "2.14.1",
    "@medusajs/medusa": "2.14.1",
    "@medusajs/types": "2.14.1",
    "@medusajs/utils": "2.14.1",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@medusajs/cli": "2.14.1",
    "@types/node": "^22.10.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3",
    "vitest": "^3.2.0"
  },
  "engines": {
    "node": ">=20"
  }
}
