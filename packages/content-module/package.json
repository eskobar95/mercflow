{
  "name": "@mercflow/content-module",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "description": "MercFlow Medusa v2 custom module: product/category CMS fields, pages CRUD (admin + store APIs, slug redirects), articles, redirects, and related DML, migrations, and services.",
  "main": "src/modules/content/index.ts",
  "exports": {
    ".": "./src/modules/content/index.ts",
    "./models": "./src/models/index.ts",
    "./mercflow-product-content-api": "./src/integrations/mercflow-product-content-api.ts",
    "./mercflow-admin-product-content-post-route": "./src/integrations/mercflow-admin-product-content-post-route.ts",
    "./mercflow-admin-product-content-read-route": "./src/integrations/mercflow-admin-product-content-read-route.ts",
    "./mercflow-store-product-content-read-route": "./src/integrations/mercflow-store-product-content-read-route.ts",
    "./mercflow-admin-category-content-read-route": "./src/integrations/mercflow-admin-category-content-read-route.ts",
    "./mercflow-admin-category-content-post-route": "./src/integrations/mercflow-admin-category-content-post-route.ts",
    "./mercflow-store-category-content-read-route": "./src/integrations/mercflow-store-category-content-read-route.ts",
    "./mercflow-admin-articles-route": "./src/integrations/mercflow-admin-articles-route.ts",
    "./mercflow-admin-articles-id-route": "./src/integrations/mercflow-admin-articles-id-route.ts",
    "./mercflow-store-articles-route": "./src/integrations/mercflow-store-articles-route.ts",
    "./mercflow-store-articles-slug-route": "./src/integrations/mercflow-store-articles-slug-route.ts",
    "./mercflow-category-content-api": "./src/integrations/mercflow-category-content-api.ts",
    "./mercflow-admin-pages-api": "./src/integrations/mercflow-admin-pages-api.ts",
    "./mercflow-admin-pages-id-api": "./src/integrations/mercflow-admin-pages-id-api.ts",
    "./mercflow-store-pages-read-route": "./src/integrations/mercflow-store-pages-read-route.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "medusa db:generate content",
    "db:migrate": "medusa db:migrate",
    "db:rollback": "medusa db:rollback --modules content"
  },
  "dependencies": {
    "@medusajs/framework": "workspace:*",
    "@medusajs/medusa": "workspace:*",
    "@medusajs/types": "workspace:*",
    "@medusajs/utils": "workspace:*",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@medusajs/cli": "workspace:*",
    "@types/node": "^22.10.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3",
    "vitest": "^3.2.0"
  },
  "engines": {
    "node": ">=20"
  }
}
