{
  "name": "@mercflow/seo-module",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "description": "MercFlow Medusa v2 module: SEO config, 301 redirects, Nordic slug utility, and public SEO routes (Batch 2).",
  "main": "src/modules/seo/index.ts",
  "exports": {
    ".": "./src/modules/seo/index.ts",
    "./slug": "./src/modules/seo/utils/slug.ts",
    "./mercflow-admin-seo-config-api": "./src/integrations/mercflow-admin-seo-config-api.ts",
    "./mercflow-admin-redirects-api": "./src/integrations/mercflow-admin-redirects-api.ts",
    "./mercflow-admin-redirects-id-api": "./src/integrations/mercflow-admin-redirects-id-api.ts",
    "./mercflow-redirect-middleware": "./src/integrations/mercflow-redirect-middleware.ts",
    "./mercflow-public-tenant-middleware": "./src/integrations/mercflow-public-tenant-middleware.ts",
    "./resolve-store-id-from-publishable-key": "./src/api/http/resolve-store-id-from-publishable-key.ts",
    "./mercflow-tenant-resolver": "./src/integrations/mercflow-tenant-resolver.ts",
    "./mercflow-sitemap-route": "./src/integrations/mercflow-sitemap-route.ts",
    "./mercflow-robots-route": "./src/integrations/mercflow-robots-route.ts",
    "./mercflow-sitemap-cache": "./src/integrations/mercflow-sitemap-cache.ts",
    "./mercflow-admin-sitemap-config-api": "./src/integrations/mercflow-admin-sitemap-config-api.ts",
    "./mercflow-admin-sitemap-preview-api": "./src/integrations/mercflow-admin-sitemap-preview-api.ts",
    "./mercflow-admin-sitemap-regenerate-api": "./src/integrations/mercflow-admin-sitemap-regenerate-api.ts",
    "./mercflow-admin-robots-config-api": "./src/integrations/mercflow-admin-robots-config-api.ts",
    "./mercflow-store-seo-json-ld-product-api": "./src/integrations/mercflow-store-seo-json-ld-product-api.ts",
    "./mercflow-store-seo-json-ld-category-api": "./src/integrations/mercflow-store-seo-json-ld-category-api.ts",
    "./mercflow-store-seo-json-ld-global-api": "./src/integrations/mercflow-store-seo-json-ld-global-api.ts",
    "./mercflow-store-seo-og-product-api": "./src/integrations/mercflow-store-seo-og-product-api.ts",
    "./mercflow-store-seo-og-category-api": "./src/integrations/mercflow-store-seo-og-category-api.ts",
    "./mercflow-store-seo-canonical-product-api": "./src/integrations/mercflow-store-seo-canonical-product-api.ts",
    "./mercflow-store-seo-canonical-category-api": "./src/integrations/mercflow-store-seo-canonical-category-api.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "medusa db:generate mercflow_seo",
    "db:migrate": "medusa db:migrate",
    "db:rollback": "medusa db:rollback --modules mercflow_seo"
  },
  "dependencies": {
    "@medusajs/framework": "2.14.1",
    "@medusajs/medusa": "2.14.1",
    "@medusajs/types": "2.14.1",
    "@medusajs/utils": "2.14.1",
    "@mercflow/content-module": "workspace:*",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@medusajs/cli": "2.14.1",
    "@types/node": "^22.10.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3",
    "vitest": "^3.2.0"
  },
  "engines": {
    "node": ">=20"
  }
}
