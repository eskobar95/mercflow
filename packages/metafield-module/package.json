{
  "name": "@mercflow/metafield-module",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "description": "MercFlow Medusa v2 module: tenant-defined metafield definitions and typed values for products and categories.",
  "main": "src/modules/metafield/index.ts",
  "exports": {
    ".": "./src/modules/metafield/index.ts",
    "./mercflow-admin-metafield-definitions-api": "./src/integrations/mercflow-admin-metafield-definitions-api.ts",
    "./mercflow-admin-metafield-definitions-id-api": "./src/integrations/mercflow-admin-metafield-definitions-id-api.ts",
    "./mercflow-admin-metafield-values-api": "./src/integrations/mercflow-admin-metafield-values-api.ts",
    "./mercflow-admin-metafield-values-batch-api": "./src/integrations/mercflow-admin-metafield-values-batch-api.ts",
    "./mercflow-admin-metafield-values-id-api": "./src/integrations/mercflow-admin-metafield-values-id-api.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "medusa db:generate metafield",
    "db:migrate": "medusa db:migrate",
    "db:rollback": "medusa db:rollback --modules metafield"
  },
  "dependencies": {
    "@medusajs/framework": "workspace:*",
    "@medusajs/medusa": "workspace:*",
    "@medusajs/types": "workspace:*",
    "@medusajs/utils": "workspace:*",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@medusajs/cli": "workspace:*",
    "@types/node": "^22.10.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3",
    "vitest": "^3.2.0"
  },
  "engines": {
    "node": ">=20"
  }
}
