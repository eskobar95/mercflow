{
  "name": "@mercflow/payment-module",
  "version": "0.1.0",
  "private": true,
  "description": "MercFlow Medusa v2 module: payment provider abstraction, per-tenant credentials, and Stripe implementation.",
  "main": "src/modules/payment/index.ts",
  "exports": {
    ".": "./src/modules/payment/index.ts",
    "./types": "./src/modules/payment/types.ts",
    "./club-stripe-product-client": "./src/modules/payment/club-stripe-product-client.ts",
