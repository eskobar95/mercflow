    "./mercflow-admin-payment-providers-api": "./src/integrations/mercflow-admin-payment-providers-api.ts",
    "./mercflow-admin-payment-providers-mode-api": "./src/integrations/mercflow-admin-payment-providers-mode-api.ts"
