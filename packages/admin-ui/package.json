{
  "name": "@mercflow/admin-ui",
  "version": "0.1.0",
  "private": true,
  "description": "MercFlow admin UI (Vite + React) — design-token integration in Batch 1; future forked Medusa admin surface",
  "type": "module",
  "scripts": {
    "prebuild": "pnpm --filter @mercflow/design-tokens build && pnpm --filter @mercflow/shared build",
    "build": "vite build",
    "test": "vitest run",
    "pretest:e2e": "pnpm --filter @mercflow/design-tokens build && pnpm --filter @mercflow/shared build",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "dev": "vite",
    "dev:playwright": "vite --host 0.0.0.0 --port 5173 --strictPort",
    "react-doctor": "react-doctor",
    "react-doctor:diff": "react-doctor --diff origin/development --verbose",
    "react-doctor:ci": "react-doctor --diff origin/development --annotations --fail-on error"
  },
  "dependencies": {
    "@medusajs/js-sdk": "2.14.1",
    "@mercflow/design-tokens": "workspace:*",
    "@mercflow/shared": "workspace:*",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-toast": "^1.2.15",
    "@tanstack/react-query": "5",
    "@tiptap/core": "^3.22.4",
    "@tiptap/extension-character-count": "^3.22.4",
    "@tiptap/extension-image": "^3.22.4",
    "@tiptap/extension-link": "^3.22.4",
    "@tiptap/react": "^3.22.4",
    "@tiptap/starter-kit": "^3.22.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "6.30.3"
  },
  "devDependencies": {
    "@medusajs/types": "2.14.1",
    "@playwright/test": "^1.50.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.10.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.15",
    "react-doctor": "^0.4.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^3.2.0"
  },
  "engines": {
    "node": ">=20"
  }
}
