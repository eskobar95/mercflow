{
  "name": "@mercflow/admin-ui",
  "version": "0.1.0",
  "private": true,
  "description": "MercFlow admin UI (Vite + React) — design-token integration in Batch 1; future forked Medusa admin surface",
  "type": "module",
  "scripts": {
    "prebuild": "pnpm --filter @mercflow/design-tokens build",
    "build": "vite build",
    "test": "vitest run",
    "pretest:e2e": "pnpm --filter @mercflow/design-tokens build",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "dev": "vite",
    "dev:playwright": "vite --host 0.0.0.0 --port 5173 --strictPort"
  },
  "dependencies": {
    "@mercflow/design-tokens": "workspace:*",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@tiptap/core": "^3.22.4",
    "@tiptap/extension-character-count": "^3.22.4",
    "@tiptap/extension-image": "^3.22.4",
    "@tiptap/extension-link": "^3.22.4",
    "@tiptap/react": "^3.22.4",
    "@tiptap/starter-kit": "^3.22.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "6.28.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.1",
    "@types/node": "^22.10.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "vite": "^6.4.3",
    "vitest": "^4.1.0"
  },
  "engines": {
    "node": ">=20"
  }
}
