# Copy to `.env.local` for local Vite dev. The admin UI runs on a different port than Medusa;
# point this at the process that serves `/admin/*` (usually `pnpm dev:backend`).
#
# Quick setup (from repo root, backend must be running on :9000):
#   pnpm shipmondo:e2e-setup
# That writes `.env.local` with a fresh JWT + MERCFLOW_DEFAULT_STORE_ID from apps/backend/.env.

VITE_MEDUSA_ADMIN_BACKEND_URL=http://localhost:9000

# Required for local dev: MercFlow admin has no login page — use a Medusa admin JWT.
# Obtain manually: POST http://localhost:9000/auth/user/emailpass with admin email/password.
# VITE_MEDUSA_ADMIN_BEARER_TOKEN=

# Required for MercFlow extension routes (order internal notes, pick list).
# Must match MERCFLOW_DEFAULT_STORE_ID in apps/backend/.env.
# VITE_MERCFLOW_DEFAULT_STORE_ID=store_01KG0VBTT0714XV2CCTEBRVC47

# Clerk (mercflow-store-admin) — T064 admin auth
# Obtain from Clerk Dashboard → API Keys → Publishable key
VITE_CLERK_PUBLISHABLE_KEY=
