# Copy to `.env.local` for local Vite dev. The admin UI runs on a different port than Medusa;
# point this at the process that serves `/admin/*` (usually `pnpm dev:backend`).

VITE_MEDUSA_ADMIN_BACKEND_URL=http://localhost:9000

# Optional: Medusa admin JWT or API token for Authorization: Bearer … when not using cookies.
# VITE_MEDUSA_ADMIN_BEARER_TOKEN=

# MercFlow tenant store for inventory-module admin routes (order notes, pick list).
# VITE_MERCFLOW_DEFAULT_STORE_ID=store_01KG0VBTT0714XV2CCTEBRVC47
