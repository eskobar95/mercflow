# Copy to `.env` in this package for local `medusa db:*` commands. Never commit `.env`.
#
# Use the same `DATABASE_URL` as `apps/backend` (see that app’s `.env` and
# `../../docker-compose.yml` for local Postgres). Do not put real credentials
# in this tracked example; fill them only in your private `.env`.
DATABASE_URL=
#
# Must match the backend Medusa app when running migrations.
JWT_SECRET=
COOKIE_SECRET=
#
# Optional (same as backend when using Medusa defaults)
# STORE_CORS=http://localhost:3000
# ADMIN_CORS=http://localhost:7001
# AUTH_CORS=http://localhost:7001
