{
  "name": "@mercflow/inventory-module",
  "version": "0.1.0",
  "private": true,
  "description": "MercFlow Medusa v2 module: internal order notes, pick-list data, and future inventory/PO surfaces.",
  "main": "src/modules/inventory/index.ts",
  "exports": {
    ".": "./src/modules/inventory/index.ts",
    "./mercflow-admin-suppliers-api": "./src/integrations/mercflow-admin-suppliers-api.ts",
    "./mercflow-admin-suppliers-id-api": "./src/integrations/mercflow-admin-suppliers-id-api.ts",
    "./mercflow-admin-purchase-orders-api": "./src/integrations/mercflow-admin-purchase-orders-api.ts",
    "./mercflow-admin-purchase-orders-status-api": "./src/integrations/mercflow-admin-purchase-orders-status-api.ts",
    "./mercflow-admin-order-notes-api": "./src/integrations/mercflow-admin-order-notes-api.ts",
    "./mercflow-admin-order-notes-id-api": "./src/integrations/mercflow-admin-order-notes-id-api.ts",
    "./mercflow-admin-pick-list-api": "./src/integrations/mercflow-admin-pick-list-api.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "medusa db:generate inventory",
    "db:migrate": "medusa db:migrate",
    "db:rollback": "medusa db:rollback --modules inventory"
  },
  "dependencies": {
    "@medusajs/framework": "2.14.1",
    "@medusajs/medusa": "2.14.1",
    "@medusajs/types": "2.14.1",
    "@medusajs/utils": "2.14.1",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@medusajs/cli": "2.14.1",
    "@types/node": "^22.10.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3",
    "vitest": "^3.2.0"
  },
  "engines": {
    "node": ">=20"
  }
}
