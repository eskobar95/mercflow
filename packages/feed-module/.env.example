# Copy to `.env` for local `medusa db:*` commands. Never commit `.env`.
# Use the same DATABASE_URL as apps/backend (see that app's `.env.example`).
DATABASE_URL=

# Optional Host → store_id map for public feed routes (JSON object). Used when scanning MERCFLOW_TENANT_STORE_IDS is not set.
# MERCFLOW_FEED_HOST_MAP={"shop.example":"store_01KG0VBTT0714XV2CCTEBRVC47"}

# Comma-separated Medusa store ids to scan mercflow_feed_config.storefront_url for Host matching.
# MERCFLOW_TENANT_STORE_IDS=store_01KG0VBTT0714XV2CCTEBRVC47
