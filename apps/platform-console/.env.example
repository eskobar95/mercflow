# Copy to `.env.local`. Never commit real keys.
#
# Clerk mercflow-platform application (separate from store admin).
VITE_PLATFORM_CLERK_PUBLISHABLE_KEY=

# Medusa backend origin for /platform API (no trailing slash).
# Vite dev proxies /platform → this origin when using the default vite.config.ts proxy.
VITE_PLATFORM_BACKEND_URL=http://localhost:9000

# Operator email domain restriction (production: mercflow.shop)
# VITE_PLATFORM_ALLOWED_EMAIL_DOMAIN=mercflow.shop
# Local dev only: override to gmail.com (or your domain) — see README "Local dev overrides"
