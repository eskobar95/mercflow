# Copy to `.env` in this directory. Never commit `.env`.
#
# PostgreSQL (Neon cloud): use the connection string from your Neon project's
# "development" branch. Find it at https://console.neon.tech under
# Project: mercflow → Branch: development → Connection string.
DATABASE_URL=
#
# Medusa: set strong random values (e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`)
JWT_SECRET=
COOKIE_SECRET=
#
# Connector module: AES-256-GCM key for encrypting connector credentials at rest.
# Generate once: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Must be exactly 64 hex characters (32 bytes). Never reuse across environments.
MERCFLOW_CONNECTOR_ENCRYPTION_KEY=
#
# CORS (optional; defaults in `medusa-config.ts` if unset)
# STORE_CORS=http://localhost:3000
# ADMIN_CORS=http://localhost:7001
# AUTH_CORS=http://localhost:7001
