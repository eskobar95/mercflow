# Copy to .env and adjust. Never commit .env. Example values are for local development only.
#
# PostgreSQL (match docker-compose.yml defaults, or your own local instance)
DATABASE_URL=postgres://mercflow:mercflow_dev@localhost:5432/mercflow

# Medusa (set strong random values locally; use a secret manager in any shared environment)
JWT_SECRET=change-me
COOKIE_SECRET=change-me

# CORS (optional; defaults in medusa-config.ts if unset)
# STORE_CORS=http://localhost:3000
# ADMIN_CORS=http://localhost:7001
# AUTH_CORS=http://localhost:7001
