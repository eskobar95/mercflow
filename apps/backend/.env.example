# Copy to `.env` in this directory. Never commit `.env`.
#
# PostgreSQL: set `DATABASE_URL` in your local `.env`. For the repo-root
# `docker compose` service, use the `POSTGRES_USER`, `POSTGRES_PASSWORD`, and
# `POSTGRES_DB` from `../../docker-compose.yml` to form the connection string
# (host `localhost`, port `5432` unless you map otherwise). See PostgreSQL
# connection-URI documentation for the format; keep secrets only in `.env`.
# Local Docker: see credentials in ../../docker-compose.yml (user/db/password) — host localhost:5432.
DATABASE_URL=
#
# Medusa: set strong random values in `.env` (e.g. `openssl rand -hex 32`). Do
# not reuse the placeholders below; leave them empty in this example file.
JWT_SECRET=
COOKIE_SECRET=
#
# CORS (optional; defaults in `medusa-config.ts` if unset)
# STORE_CORS=http://localhost:3000
# ADMIN_CORS=http://localhost:7001
# AUTH_CORS=http://localhost:7001
#
# Translation feature flag — enables Medusa `GET /admin/locales` and the translation module.
# Required for MercFlow admin Content tabs (product/category SEO + rich text per locale).
# MEDUSA_FF_TRANSLATION=true
#
# MercFlow inventory-module: default Medusa store id for admin extension routes (order notes, pick list).
# MERCFLOW_DEFAULT_STORE_ID=store_01KG0VBTT0714XV2CCTEBRVC47
#
# MercFlow connector module: 32-byte AES-256 key as 64 hex characters (generate e.g. `openssl rand -hex 32`).
# Required when the connector module is registered; used only for encrypting stored connector credentials.
MERCFLOW_CONNECTOR_ENCRYPTION_KEY=
#
# MercFlow payment-module: 32-byte AES-256 key as 64 hex characters (generate e.g. `openssl rand -hex 32`).
# Required at application startup when payment-module is registered; encrypts Stripe secret keys at rest.
MERCFLOW_ENCRYPTION_KEY=
#
# Shipmondo (connector-module): env fallback until credentials are saved in Admin → Connectors → Shipmondo.
# Use sandbox for local HITL label verification (T053).
# SHIPMONDO_SANDBOX=true
# SHIPMONDO_API_USER=
# SHIPMONDO_API_KEY=
#
# Plunk email (connector-module): legacy env fallback until credentials are configured in admin.
# When Plunk credentials are saved via admin, neither variable is strictly required at runtime if you migrate fully.
# PLUNK_SECRET_KEY=
# Optional regional override (default https://api.useplunk.com):
# PLUNK_API_BASE_URL=
#
# Rate limiting (in-memory TTL; see apps/backend/src/api/middlewares.ts)
# RATE_LIMIT_PUBLIC_RPM=60
# RATE_LIMIT_STORE_RPM=300
#
# Feed module: Host → store_id for GET /feed/* (JSON map and/or storefront_url scan)
# MERCFLOW_FEED_HOST_MAP={"shop.example":"store_01KG0VBTT0714XV2CCTEBRVC47"}
# MERCFLOW_TENANT_STORE_IDS=store_01KG0VBTT0714XV2CCTEBRVC47
#
# MercFlow seo-module: also uses MERCFLOW_DEFAULT_STORE_ID for admin SEO routes and redirect
# middleware when Host→store mapping is not configured (local dev).

# Observability (see infra/RUNBOOK.md)
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=development
# SENTRY_ENABLED=true
#
# T030 provision-tenant — required when running `pnpm provision-tenant` from repo root
# MEDUSA_BACKEND_URL=https://api.mercflow.shop
# MEDUSA_ADMIN_API_TOKEN=

# Clerk (mercflow-store-admin) — T064 admin auth
# Obtain from Clerk Dashboard → API Keys → Secret key
CLERK_SECRET_KEY=

# Clerk (mercflow-platform) — T067 Platform Console
# Separate Clerk application — tokens are not interchangeable with store admin.
# PLATFORM_CLERK_SECRET_KEY=
# PLATFORM_ALLOWED_EMAIL_DOMAIN=mercflow.shop
# Local dev only: override in .env (never commit) — see apps/platform-console/README.md
# PLATFORM_CORS=http://localhost:5174
#
# BYPASSRLS connection for /platform/* routes (mercflow_owner or equivalent).
# Use a dedicated Neon role — never reuse mercflow_app.
# PLATFORM_DATABASE_URL=

# Amazon SES (notification-module T057/T058) — IAM user with SES permissions
# Region must match where mail.mercflow.shop identity was created (eu-north-1)
# AWS_REGION=eu-north-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# BullMQ notification queue (T056) — local Docker Redis or compose internal URL in prod
# REDIS_URL=redis://localhost:6379

# Platform Console system metrics (T070)
# HETZNER_API_TOKEN=
# HETZNER_SERVER_ID=
# NEON_API_KEY=
# NEON_PROJECT_ID=
# NEON_BRANCH_ID=
# NEON_MAX_CONNECTIONS=100

# Tenant onboarding (T086/T088) — Stripe platform billing for MercFlow subscription fee
# Stripe platform billing (M019 tenant onboarding — MercFlow's own Stripe account, not per-tenant payment-module)
# Plans (Standard/Pro, Monthly/Annual, multi-currency) are defined in Stripe Dashboard — not in env.
STRIPE_PLATFORM_SECRET_KEY=
STRIPE_PLATFORM_PUBLISHABLE_KEY=
STRIPE_PLATFORM_WEBHOOK_SECRET=

# Tenant onboarding invites (T086)
# MERCFLOW_SIGNUP_BASE_URL=https://admin.mercflow.shop/signup
# PLATFORM_INVITE_FROM_EMAIL=noreply@mail.mercflow.shop
