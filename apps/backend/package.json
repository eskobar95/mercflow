{
  "name": "@mercflow/backend",
  "version": "0.1.0",
  "private": true,
  "description": "MercFlow Medusa v2 backend \u2014 registers MercFlow modules and hosts the admin API.",
  "scripts": {
    "dev": "medusa develop",
    "start": "medusa start",
    "build": "medusa build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate": "medusa db:migrate",
    "db:revert": "medusa db:revert",
    "seed:shipmondo-e2e": "medusa exec ./src/scripts/seed-shipmondo-e2e.ts"
  },
  "dependencies": {
    "@clerk/backend": "^3.6.1",
    "@medusajs/core-flows": "2.14.0",
    "@medusajs/draft-order": "2.14.1",
    "@medusajs/framework": "workspace:*",
    "@medusajs/medusa": "workspace:*",
    "@medusajs/tenancy-core": "workspace:*",
    "@medusajs/utils": "workspace:*",
    "@mercflow/connector-module": "workspace:*",
    "@mercflow/content-module": "workspace:*",
    "@mercflow/feed-module": "workspace:*",
    "@mercflow/inventory-module": "workspace:*",
    "@mercflow/metafield-module": "workspace:*",
    "@mercflow/packaging-module": "workspace:*",
    "@mercflow/notification-module": "workspace:*",
    "@mercflow/payment-module": "workspace:*",
    "@mercflow/seo-module": "workspace:*",
    "@mercflow/subscription-module": "workspace:*",
    "@mercflow/worker": "workspace:*",
