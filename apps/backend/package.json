    "@react-email/components": "^0.0.31",
    "@react-email/render": "^1.0.4",
    "bullmq": "5.13.0",
    "ioredis": "^5.4.2",
    "pg": "^8.16.3",
    "react": "^18.3.1",
    "stripe": "15.12.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/pg": "^8.15.5",
    "@medusajs/cli": "workspace:*",
    "@types/node": "^22.10.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3",
    "vitest": "^3.2.0",
    "@types/react": "^18.3.18"
  },
  "engines": {
    "node": ">=20"
  }
