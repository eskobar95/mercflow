{
  "name": "@mercflow/backend",
  "version": "0.1.0",
  "private": true,
  "description": "MercFlow Medusa v2 backend — registers MercFlow modules and hosts the admin API.",
  "scripts": {
    "dev": "medusa develop",
    "start": "medusa start",
    "build": "medusa build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate": "medusa db:migrate",
    "db:rollback": "medusa db:rollback --modules content"
  },
  "dependencies": {
    "@medusajs/admin-sdk": "2.14.1",
    "@medusajs/admin-shared": "2.14.1",
    "@medusajs/dashboard": "2.14.1",
    "@medusajs/draft-order": "2.14.1",
    "@medusajs/framework": "2.14.1",
    "@medusajs/medusa": "2.14.1",
    "@medusajs/utils": "2.14.1",
    "@mercflow/content-module": "workspace:*",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@medusajs/cli": "2.14.1",
    "@types/node": "^22.10.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3",
    "vitest": "^3.2.0"
  },
  "engines": {
    "node": ">=20"
  }
}
